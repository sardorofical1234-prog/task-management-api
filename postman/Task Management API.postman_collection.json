{
  "info": {
    "name": "Task Management API",
    "description": "Local portfolio demo for Java 21, Spring Boot, JWT, tasks, projects and comments. Select the Local environment and run requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "demoEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "Portfolio123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectTaskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register demo user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"demoEmail\", `portfolio-${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User registered', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.email).to.eql(pm.collectionVariables.get('demoEmail'));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "2. Login and save JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login successful', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "3. Create standalone task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Task created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.id).to.exist;",
              "pm.collectionVariables.set('taskId', String(body.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare portfolio demo\",\n  \"description\": \"Demonstrate task creation, JWT authentication and ownership.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "4. List my tasks",
      "event": [],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tasks?page=0&size=10&sortBy=createdAt&direction=desc"
      },
      "response": []
    },
    {
      "name": "5. Update task status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Task status updated', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().status).to.eql('IN_PROGRESS');"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "6. Create project",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Project created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.id).to.exist;",
              "pm.collectionVariables.set('projectId', String(body.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/projects",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Portfolio Demo Project\",\n  \"description\": \"A sample project created from the Postman collection.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "7. Create task inside project",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Project task created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.id).to.exist;",
              "pm.collectionVariables.set('projectTaskId', String(body.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Build project collaboration demo\",\n  \"description\": \"This task belongs to the demo project.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "8. Add task comment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Comment created', () => pm.response.to.have.status(201));",
              "pm.expect(pm.response.json().content).to.eql('The project task and comment flow are working.');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tasks/{{projectTaskId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"The project task and comment flow are working.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "9. List task comments",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Comments listed', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tasks/{{projectTaskId}}/comments"
      },
      "response": []
    },
    {
      "name": "10. Readiness health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API and database are ready', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().status).to.eql('UP');"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health/readiness"
      },
      "response": []
    }
  ]
}
